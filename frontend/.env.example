# Local API (frontend → local backend)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MEDIA_BASE_URL=
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=
NEXT_PUBLIC_E2E_TEST_MODE=false

# Messenger 공유 (없으면 Messenger 버튼은 링크 복사 fallback)
NEXT_PUBLIC_FACEBOOK_APP_ID=

# KakaoTalk 공유 (JavaScript 키 — REST/Admin Key 금지)
# 개발자 콘솔 Web 도메인에 frontend-development URL 등록 필요
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=

# Google Maps (브라우저 공개 키 — 하드코딩 금지)
# Console에서 Maps JavaScript API + Places API + Maps Embed API 활성화
# HTTP referrer: localhost:3000/*, frontend-development-*.up.railway.app/*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Advanced Marker 사용 시 선택 (없어도 classic Marker로 표시됨)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Naver Maps (브라우저 Client ID — secret 금지)
# 콘솔에서 Web 서비스 URL에 localhost + development FE 도메인 등록
NEXT_PUBLIC_NAVER_MAPS_CLIENT_ID=

# Toss Payments — Global-first USD (외화결제 MID client key only; never secrets)
# Pair with Backend TOSS_PAYMENTS_SECRET_KEY (same test_/live_ mode)
NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY=
# Optional admin variantKey for USD foreign MID:
# NEXT_PUBLIC_TOSS_PAYMENTS_VARIANT_KEY=

# Railway production 값을 여기에 넣지 마세요.
# Railway dev/prod 연동은 로컬 QA 통과 후에만 합니다.

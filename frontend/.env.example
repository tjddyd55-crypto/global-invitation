# General API (optional if you set ADMIN base below). Must be absolute URL when used for API calls.
NEXT_PUBLIC_API_BASE_URL=
# Required for split deploy (Railway frontend → Railway backend). Admin/super-admin requests use ONLY this
# (or NEXT_PUBLIC_API_BASE_URL) — never the Next.js page origin.
# Railway: Variables → add → redeploy frontend after save.
# Example: NEXT_PUBLIC_ADMIN_API_BASE_URL=https://backend-production-xxxx.up.railway.app
NEXT_PUBLIC_ADMIN_API_BASE_URL=
NEXT_PUBLIC_MEDIA_BASE_URL=https://pub-xxxxxxxx.r2.dev
NEXT_PUBLIC_E2E_TEST_MODE=false

# =============================================================================
# Local-first development (Railway production 금지 / Railway DB migrate 금지)
# =============================================================================
# 1) Local Postgres (Docker 권장):
#      docker compose up -d
#    또는 로컬에 설치한 PostgreSQL 에 DB 생성 후 아래 URL 사용
# 2) cd backend && npx prisma migrate dev && npx prisma generate && npm run dev
# 3) cd frontend && npm run dev
# 4) 로컬 QA 통과 후에만 Railway dev 켜고 migrate deploy
# =============================================================================

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/global_invitation?schema=public"
PORT=3001
NODE_ENV=development

# Email OTP: mock = 서버 로그 + (비production) UI previewCode
# production 에서는 EMAIL_PROVIDER=smtp 로 바꾸고 EMAIL_ENABLED=true 만 실발송
EMAIL_PROVIDER=mock
EMAIL_ENABLED=false
EMAIL_CODE_PEPPER=dev-email-code-pepper-change-me
SERVICE_NAME=Global Invitation

ADMIN_ID=admin@naver.com
ADMIN_PASSWORD=change-me
ADMIN_JWT_SECRET=change-me
ADMIN_SESSION_SECRET=change-me

# 슈퍼관리자 (/admin/super/*, JWT role SUPER_ADMIN). 미설정 시 슈퍼 로그인 불가.
SUPER_ADMIN_EMAIL=super@example.com
SUPER_ADMIN_PASSWORD=change-me-super

# Browser Origin must match exactly for credentialed CORS
FRONTEND_URL=http://localhost:3000
FRONTEND_PREVIEW_URL=
FRONTEND_ALLOWED_ORIGINS=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=invitation-media
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
R2_REGION=auto
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com

# Backward compatibility only (prefer R2_PUBLIC_BASE_URL)
R2_PUBLIC_URL=

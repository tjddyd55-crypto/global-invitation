DATABASE_URL="postgresql://postgres:password@localhost:5432/global_invitation"
PORT=3001

ADMIN_ID=admin@naver.com
ADMIN_PASSWORD=change-me
ADMIN_JWT_SECRET=change-me
ADMIN_SESSION_SECRET=change-me

# 슈퍼관리자 (/admin/super/*, JWT role SUPER_ADMIN). 미설정 시 슈퍼 로그인 불가.
SUPER_ADMIN_EMAIL=super@example.com
SUPER_ADMIN_PASSWORD=change-me-super
# Browser Origin must match exactly for credentialed CORS (include trailing slash only if your app uses it).
FRONTEND_URL=http://localhost:3000
FRONTEND_PREVIEW_URL=
# Comma-separated extra origins (preview deploys, alternate domains).
# Production example: https://frontend-production-54bf.up.railway.app
FRONTEND_ALLOWED_ORIGINS=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=invitation-media
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
R2_REGION=auto
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com

# Backward compatibility only (prefer R2_PUBLIC_BASE_URL)
R2_PUBLIC_URL=

# =============================================================================
# Local-first development (Railway production 금지 / Railway DB migrate 금지)
# =============================================================================
# 1) Local Postgres (Docker 권장):
#      docker compose up -d
#    또는 로컬에 설치한 PostgreSQL 에 DB 생성 후 아래 URL 사용
# 2) cd backend && npx prisma migrate dev && npx prisma generate && npm run dev
# 3) cd frontend && npm run dev
# 4) 로컬 QA 통과 후에만 Railway dev 켜고 migrate deploy
# =============================================================================

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/global_invitation?schema=public"
PORT=3001
NODE_ENV=development

# Email OTP: mock = 서버 로그 + (개발 flag 시) UI previewCode
# development 실발송: EMAIL_PROVIDER=smtp + EMAIL_ENABLED=true + SMTP_* 필수
# previewCode 는 canExposeEmailPreviewCode() 가 true 일 때만 API 응답에 포함.
# production / smtp / EMAIL_ENABLED=true 에서는 ALLOW_EMAIL_PREVIEW_CODE=true 여도 절대 노출 금지.
EMAIL_PROVIDER=mock
EMAIL_ENABLED=false
# Development mock email only. Never enable in production.
ALLOW_EMAIL_PREVIEW_CODE=false
EMAIL_CODE_PEPPER=dev-email-code-pepper-change-me
SERVICE_NAME=Global Invitation

# SMTP (EMAIL_PROVIDER=smtp 이고 EMAIL_ENABLED=true 일 때만 사용)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

ADMIN_ID=admin@naver.com
ADMIN_PASSWORD=change-me
ADMIN_JWT_SECRET=change-me
ADMIN_SESSION_SECRET=change-me

# 슈퍼관리자 (/admin/super/*, JWT role SUPER_ADMIN). 미설정 시 슈퍼 로그인 불가.
SUPER_ADMIN_EMAIL=super@example.com
SUPER_ADMIN_PASSWORD=change-me-super

# Browser Origin must match exactly for credentialed CORS
FRONTEND_URL=http://localhost:3000
FRONTEND_PREVIEW_URL=
FRONTEND_ALLOWED_ORIGINS=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=platform-assets
R2_PUBLIC_BASE_URL=https://cdn.example.com
R2_REGION=auto
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# Global Invitation 전용 (사용자/shared/temp 키 SSOT). R2_KEY_PREFIX 와 분리.
INVITATION_R2_ROOT_PREFIX=invitation
INVITATION_ASSET_ENVIRONMENT=development
# 다른 서비스/legacy template 키용. Invitation 사용자 자산 builder 에서는 사용하지 않음.
# R2_KEY_PREFIX=development

# Backward compatibility only (prefer R2_PUBLIC_BASE_URL)
R2_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Invitation publish payments (Toss — Global-first USD)
# Product SSOT: USD list $30 / promo $10 (Admin DB → code default). No FX.
# Primary channel: INTERNATIONAL_USD (Toss 외화결제 MID).
# Domestic KRW is secondary and NOT enabled — do not set SETTLEMENT_*=KRW.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
# PAYMENT_PROVIDER=toss_payments
TOSS_PAYMENTS_SECRET_KEY=
TOSS_PAYMENTS_CLIENT_KEY=
# Optional Toss admin variantKey for 외화결제 MID:
# TOSS_PAYMENTS_VARIANT_KEY=
PAYMENT_WEBHOOK_SECRET=dev-mock-webhook-secret

# AES-256-GCM root key for Admin Toss credential encryption (64 hex or base64 32 bytes).
# Never commit a real production key. Required to save Toss secrets from Admin UI.
# ADMIN_SETTINGS_ENCRYPTION_KEY=

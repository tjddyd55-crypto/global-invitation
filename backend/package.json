{
  "name": "global-invitation-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20"
  },
  "scripts": {
    "dev": "node --max-old-space-size=2048 ./node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "start": "prisma migrate deploy && node dist/index.js",
    "build": "tsc",
    "postinstall": "prisma generate",
    "lint": "node --max-old-space-size=2048 ./node_modules/eslint/bin/eslint.js src",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:verify": "tsx scripts/verify-tables.ts",
    "templates:migrate": "tsx scripts/migrate-template-registry-to-db.ts",
    "test:preview-code": "tsx --test src/lib/mailer.previewCode.test.ts",
    "test:admin-session": "tsx --test src/lib/adminSession.cookie.test.ts src/routes/adminAuth.cors.test.ts src/routes/adminAuth.role.test.ts",
    "test:audio-probe": "tsx --test src/lib/audio/playableAudioProbe.test.ts",
    "test:r2-cleanup": "tsx --test src/lib/r2Cleanup/legacyInvitationClassification.test.ts",
    "music:archive-qa-placeholder": "tsx scripts/archive-qa-placeholder-music.ts",
    "audit:r2:legacy-invitation": "tsx scripts/audit-legacy-invitation-r2-assets.ts",
    "delete:r2:legacy-invitation": "tsx scripts/delete-legacy-invitation-r2-assets.ts",
    "invitation:media:audit": "tsx scripts/audit-temp-invitation-media.ts",
    "invitation:media:cleanup": "tsx scripts/cleanup-temp-invitation-media.ts",
    "invitation:media:verify-dev": "tsx scripts/verify-temp-invitation-media-dev.ts",
    "invitation:media:lifecycle-fixtures": "tsx scripts/lifecycle-temp-media-fixtures.ts",
    "test:temp-media": "tsx --test src/lib/tempInvitationMedia/tempInvitationMedia.test.ts",
    "test:payments": "tsx --test src/lib/payments/pricing.provider.test.ts src/lib/ops/adminOps.crypto.test.ts src/lib/ops/paymentProviderConfig.test.ts src/lib/payments/tossClient.probe.test.ts",
    "admin:sync-visual-templates": "tsx scripts/sync-visual-template-catalog.ts",
    "test:visual-catalog": "tsx --test src/lib/visualTemplates/catalogService.test.ts src/lib/visualTemplates/definition/definition.test.ts",
    "audit:invitation-payment-entitlements": "tsx scripts/audit-invitation-payment-entitlements.ts",
    "music:publish-jci-organization": "tsx scripts/publish-jci-organization-music.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1004.0",
    "@aws-sdk/s3-request-presigner": "^3.1005.0",
    "@prisma/client": "^5.7.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "multer": "^2.1.1",
    "music-metadata": "^7.14.0",
    "nodemailer": "^6.10.1",
    "prisma": "^5.7.0",
    "sharp": "^0.34.5",
    "typescript": "^5.3.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.24",
    "@types/supertest": "^7.2.1",
    "eslint": "^8.55.0",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0"
  }
}

{
  "name": "global-invitation-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20"
  },
  "scripts": {
    "dev": "node --max-old-space-size=2048 ./node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "start": "prisma migrate deploy && node dist/index.js",
    "build": "tsc",
    "postinstall": "prisma generate",
    "lint": "node --max-old-space-size=2048 ./node_modules/eslint/bin/eslint.js src",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:verify": "tsx scripts/verify-tables.ts",
    "templates:migrate": "tsx scripts/migrate-template-registry-to-db.ts",
    "test:preview-code": "tsx --test src/lib/mailer.previewCode.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1004.0",
    "@aws-sdk/s3-request-presigner": "^3.1005.0",
    "@prisma/client": "^5.7.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "multer": "^2.1.1",
    "nodemailer": "^6.10.1",
    "prisma": "^5.7.0",
    "sharp": "^0.34.5",
    "typescript": "^5.3.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.24",
    "eslint": "^8.55.0",
    "tsx": "^4.7.0"
  }
}

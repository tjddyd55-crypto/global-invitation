// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OwnerType {
  GUEST
  USER
}

enum InvitationStatus {
  DRAFT
  SHARED
  PUBLISHED
}

enum TemplateSubmissionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum UserRole {
  USER
  CREATOR
  ADMIN
}

enum TemplateStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PUBLISHED
}

enum CreatorPayoutStatus {
  PENDING
  PAID
  CANCELLED
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String?  @unique
  nickname  String?  @map("nickname")
  passwordHash String? @map("password_hash")
  role      UserRole @default(USER)
  isCreator Boolean  @default(false) @map("is_creator")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  invitations         Invitation[]
  templateUsages      TemplateUsage[]   @relation("TemplateUsageUsedByUser")
  templateRevenues    TemplateRevenue[] @relation("TemplateRevenueCreator")
  templateViews       TemplateView[]    @relation("TemplateViewByUser")
  templateClones      TemplateClone[]   @relation("TemplateCloneByUser")
  creatorPayouts      CreatorPayout[]   @relation("CreatorPayoutByUser")
  templateSubmissions TemplateSubmission[]
  magicLinkTokens      MagicLinkToken[]
  authSessions         AuthSession[]
  mediaFiles           MediaFile[]
  createdMediaFiles    MediaFile[] @relation("MediaFileCreatedBy")

  @@map("users")
}

model Invitation {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerType   OwnerType        @default(GUEST) @map("owner_type")
  ownerId     String           @map("owner_id") // userId(UUID) 또는 guestToken(String)
  createdBy   String?          @map("created_by")
  userId      String?          @map("user_id") @db.Uuid
  guestToken  String?          @map("guest_token")
  templateId  String?          @map("template_id") @db.Uuid
  slug        String           @unique
  shareSlug   String?          @unique @map("share_slug")
  title       String?          // 행사명 또는 제목
  data        Json?            @db.JsonB
  dataJson    Json?            @map("data_json") @db.JsonB
  eventDate   DateTime?        @map("event_date") @db.Timestamptz(6)
  locationText String?         @map("location_text") // 장소 정보
  message     String?          // 초대장 메시지
  templateKey String           @default("basic") @map("template_key")
  musicKey    String?          @map("music_key")
  countryCode String           @default("GLOBAL") @map("country_code")
  language    String           @default("en")
  status      InvitationStatus @default(DRAFT)
  isPublished Boolean          @default(false) @map("is_published")
  isPaid      Boolean          @default(false) @map("is_paid")
  canShare    Boolean          @default(false) @map("can_share")
  paidAt      DateTime?        @map("paid_at") @db.Timestamptz(6)
  publishedAt DateTime?        @map("published_at") @db.Timestamptz(6)
  rsvpDeadline DateTime?       @map("rsvp_deadline") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  template Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  rsvps          RSVP[]
  views          InvitationView[]
  templateUsages TemplateUsage[]
  templateClones TemplateClone[]

  @@index([ownerId])
  @@index([guestToken])
  @@index([templateId])
  @@map("invitations")
}

model RSVP {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invitationId String    @map("invitation_id") @db.Uuid
  guestName   String     @map("guest_name")
  attendance  String
  guestCount  Int        @default(1) @map("guest_count")
  mealChoice  String?    @map("meal_choice")
  message     String?
  isHidden    Boolean    @default(false) @map("is_hidden")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@unique([invitationId, guestName])
  @@map("rsvps")
}

model InvitationView {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invitationId String    @map("invitation_id") @db.Uuid
  viewedAt    DateTime   @default(now()) @map("viewed_at") @db.Timestamptz(6)
  viewerIp    String?    @map("viewer_ip")
  userAgent   String?    @map("user_agent")
  referrer    String?
  deviceType  String?    @map("device_type")
  countryCode String?    @map("country_code")
  sessionId   String?    @map("session_id")

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@index([viewedAt])
  @@index([invitationId, viewedAt])
  @@map("invitation_views")
}

model MediaFile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  ownerType String?  @map("owner_type")
  ownerRefId String? @map("owner_ref_id")
  usage     String?
  objectKey String?  @unique @map("object_key")
  publicUrl String?  @map("public_url")
  url       String
  fileName  String   @map("file_name")
  mimeType  String   @map("mime_type")
  fileSize  Int      @map("file_size")
  width     Int?
  height    Int?
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  creator User? @relation("MediaFileCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([ownerType, ownerRefId])
  @@index([usage, createdAt])
  @@map("media_files")
}

model MagicLinkToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique
  email     String
  userId    String   @map("user_id") @db.Uuid
  guestToken String? @map("guest_token")
  draftSlug String?  @map("draft_slug")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("magic_link_tokens")
}

model AuthSession {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model EventLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType    String   @map("event_type")
  templateType String   @map("template_type")
  language     String   @map("language")
  pageUrl      String   @map("page_url")
  metadata     Json?    @map("metadata")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("event_logs")
}

model AdminAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId    String   @map("admin_id")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@map("admin_audit_logs")
}

model Template {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String   @unique
  name            String
  category        String
  style           String
  description     String
  price           Int
  creatorShare    Float    @map("creator_share")
  creatorId       String?  @map("creator_id")
  component       String
  templateKey     String   @map("template_key")
  marketplaceType String   @map("marketplace_type")
  status          TemplateStatus @default(DRAFT)
  studioConfig    Json?    @map("studio_config") @db.JsonB
  thumbnailUrl    String?  @map("thumbnail_url")
  previewThumbnailUrl String? @map("preview_thumbnail_url")
  sourceSubmissionId String? @map("source_submission_id") @db.Uuid
  isActive        Boolean  @default(true) @map("is_active")
  isDeleted       Boolean  @default(false) @map("is_deleted")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  fields              TemplateField[]
  invitations         Invitation[]
  versions            TemplateVersion[]
  templateViews       TemplateView[]
  templateClones      TemplateClone[]
  templateUsages      TemplateUsage[]
  templateRevenues    TemplateRevenue[]
  approvedSubmissions TemplateSubmission[]

  @@map("templates")
}

model TemplateField {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId  String   @map("template_id") @db.Uuid
  fieldName   String   @map("field_name")
  fieldType   String   @map("field_type")
  label       String
  placeholder String   @default("")
  isRequired  Boolean  @default(false) @map("is_required")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, fieldName])
  @@index([templateId, sortOrder])
  @@map("template_fields")
}

model TemplateSubmission {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorId          String                   @map("creator_id") @db.Uuid
  category           String
  templateKeyCandidate String                 @map("template_key_candidate")
  name               String
  description        String
  style              String
  price              Int                      @default(0)
  creatorShare       Float                    @default(0) @map("creator_share")
  status             TemplateSubmissionStatus @default(DRAFT)
  studioConfig       Json?                    @map("studio_config") @db.JsonB
  previewThumbnailUrl String?                 @map("preview_thumbnail_url")
  parentSubmissionId String?                  @map("parent_submission_id") @db.Uuid
  revisionNumber     Int                      @default(1) @map("revision_number")
  submittedAt        DateTime?                @map("submitted_at") @db.Timestamptz(6)
  reviewedAt         DateTime?                @map("reviewed_at") @db.Timestamptz(6)
  reviewNote         String?                  @map("review_note")
  approvedTemplateId String?                  @map("approved_template_id") @db.Uuid
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator            User                     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  parentSubmission   TemplateSubmission?      @relation("TemplateSubmissionRevision", fields: [parentSubmissionId], references: [id], onDelete: SetNull)
  childSubmissions   TemplateSubmission[]     @relation("TemplateSubmissionRevision")
  approvedTemplate   Template?                @relation(fields: [approvedTemplateId], references: [id], onDelete: SetNull)

  @@index([creatorId, status])
  @@index([status, submittedAt])
  @@unique([creatorId, templateKeyCandidate, revisionNumber])
  @@map("template_submissions")
}

model TemplateUsage {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId           String   @map("template_id") @db.Uuid
  templateVersionId    String?  @map("template_version_id") @db.Uuid
  invitationId         String   @map("invitation_id") @db.Uuid
  usedByUserId         String?  @map("used_by_user_id") @db.Uuid
  usedByGuestToken     String?  @map("used_by_guest_token")
  priceSnapshot        Int      @map("price_snapshot")
  creatorShareSnapshot Float    @map("creator_share_snapshot")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  template   Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateVersion TemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: SetNull)
  invitation Invitation      @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  usedByUser User?           @relation("TemplateUsageUsedByUser", fields: [usedByUserId], references: [id], onDelete: SetNull)
  clone      TemplateClone?
  revenue    TemplateRevenue?

  @@unique([invitationId])
  @@index([templateId, createdAt])
  @@index([templateVersionId, createdAt])
  @@index([usedByUserId, createdAt])
  @@map("template_usages")
}

model TemplateRevenue {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usageId              String   @unique @map("usage_id") @db.Uuid
  templateId           String   @map("template_id") @db.Uuid
  creatorId            String?  @map("creator_id") @db.Uuid
  totalAmount          Int      @map("total_amount")
  creatorRevenue       Float    @map("creator_revenue")
  platformRevenue      Float    @map("platform_revenue")
  creatorShareSnapshot Float    @map("creator_share_snapshot")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  usage    TemplateUsage @relation(fields: [usageId], references: [id], onDelete: Cascade)
  template Template      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  creator  User?         @relation("TemplateRevenueCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  @@index([templateId, createdAt])
  @@index([creatorId, createdAt])
  @@map("template_revenues")
}

model TemplateVersion {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId        String   @map("template_id") @db.Uuid
  versionNumber     Int      @map("version_number")
  templateKey       String   @map("template_key")
  name              String
  style             String
  description       String
  price             Int
  creatorShare      Float    @map("creator_share")
  studioConfig      Json?    @map("studio_config") @db.JsonB
  thumbnailUrl      String?  @map("thumbnail_url")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  template          Template       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateUsages    TemplateUsage[]
  templateClones    TemplateClone[]

  @@unique([templateId, versionNumber])
  @@index([templateId, createdAt])
  @@map("template_versions")
}

model TemplateView {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId       String   @map("template_id") @db.Uuid
  viewerUserId     String?  @map("viewer_user_id") @db.Uuid
  viewerGuestToken String?  @map("viewer_guest_token")
  sessionId        String?  @map("session_id")
  referrer         String?
  userAgent        String?  @map("user_agent")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  template         Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  viewerUser       User?    @relation("TemplateViewByUser", fields: [viewerUserId], references: [id], onDelete: SetNull)

  @@index([templateId, createdAt])
  @@index([viewerUserId, createdAt])
  @@map("template_views")
}

model TemplateClone {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId        String   @map("template_id") @db.Uuid
  templateVersionId String?  @map("template_version_id") @db.Uuid
  templateUsageId   String?  @unique @map("template_usage_id") @db.Uuid
  invitationId      String   @map("invitation_id") @db.Uuid
  clonedByUserId    String?  @map("cloned_by_user_id") @db.Uuid
  clonedByGuestToken String? @map("cloned_by_guest_token")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  template          Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateVersion   TemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: SetNull)
  templateUsage     TemplateUsage?  @relation(fields: [templateUsageId], references: [id], onDelete: SetNull)
  invitation        Invitation      @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  clonedByUser      User?           @relation("TemplateCloneByUser", fields: [clonedByUserId], references: [id], onDelete: SetNull)

  @@index([templateId, createdAt])
  @@index([templateVersionId, createdAt])
  @@index([clonedByUserId, createdAt])
  @@map("template_clones")
}

model CreatorPayout {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorId       String             @map("creator_id") @db.Uuid
  periodStart     DateTime           @map("period_start") @db.Timestamptz(6)
  periodEnd       DateTime           @map("period_end") @db.Timestamptz(6)
  totalRevenue    Float              @map("total_revenue")
  totalUsageCount Int                @default(0) @map("total_usage_count")
  status          CreatorPayoutStatus @default(PENDING)
  paidAt          DateTime?          @map("paid_at") @db.Timestamptz(6)
  note            String?
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator         User               @relation("CreatorPayoutByUser", fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, periodStart, periodEnd])
  @@index([creatorId, status])
  @@index([creatorId, createdAt])
  @@map("creator_payouts")
}

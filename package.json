{
  "name": "global-invitation",
  "version": "0.1.0",
  "private": true,
  "description": "Global SaaS platform for creating and sharing digital invitations",
  "scripts": {
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "install:backend": "npm ci --prefix backend --include=dev",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "prebuild": "npm run install:backend",
    "build": "npm run build:backend",
    "start": "npm run start --prefix backend",
    "check:i18n": "ts-node scripts/check-i18n.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "design:qa:screenshots": "playwright test e2e/design-qa-screenshots.spec.ts --project=chromium",
    "figma:pixel:diff": "node scripts/figma-pixel-qa/pixel-diff.mjs",
    "figma:pixel:qa": "playwright test e2e/figma-pixel-overlay.spec.ts --project=chromium"
  },
  "workspaces": [],
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
